NODE_ENV=development
PORT=3003
CLIENT_URL=http://localhost:3005
DATABASE_URL=postgresql://banjo:banjo@localhost:5432/banjodraw
# trace, debug, info (default), warn, error, fatal, or silent
# LOG_LEVEL=info

# Sign in without OAuth at /login/local. Only works with NODE_ENV=development and a
# database on localhost. Set VITE_LOCAL_DEVELOPMENT=true in apps/web/.env for the button.
LOCAL_DEVELOPMENT=true

# OAuth apps. Callbacks: http://localhost:3003/login/github/callback and
# http://localhost:3003/login/google/callback. Any value works if you only sign in locally.
GITHUB_CLIENT_ID=local
GITHUB_CLIENT_SECRET=local
GOOGLE_CLIENT_ID=local
GOOGLE_CLIENT_SECRET=local
GOOGLE_REDIRECT_URI=http://localhost:3003/login/google/callback

# Local S3 from docker/docker-compose.yml. Remove CLOUDFLARE_ENDPOINT to use Cloudflare R2.
CLOUDFLARE_ENDPOINT=http://localhost:9000
CLOUDFLARE_ACCOUNT_ID=local
CLOUDFLARE_ACCESS_KEY_ID=local-access-key
CLOUDFLARE_SECRET_ACCESS_KEY=local-secret-key
CLOUDFLARE_BUCKET_NAME=banjodraw
