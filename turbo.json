{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^db:generate"],
            "env": ["DATABASE_URL"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".vercel/**"]
        },
        "test": {
            "dependsOn": ["^db:generate"]
        },
        "dev": {
            "dependsOn": ["^db:generate"],
            "cache": false,
            "persistent": true
        },
        "db:generate": {
            "cache": false
        },
        "db:push": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^db:generate", "db:generate"],
            "cache": false
        }
    }
}
